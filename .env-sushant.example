NODE_ENV=development
DEMO_MODE=true
PORT=4000
# Local development replica set (single-node rs0). Start with `npm run mongo:dev`.
# A standalone mongod cannot run wallet/payment/refund/admin-funds transactions (MongoDB code 20).
MONGODB_URI=mongodb://127.0.0.1:27018/nepal_hand_pay?replicaSet=rs0
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
PALM_SERVICE_URL=http://localhost:8001
PALM_SERVICE_KEY=replace-with-a-separate-32-character-service-key
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PALM_TEMPLATE_ENCRYPTION_KEY=replace-with-a-generated-fernet-key
REDIS_URL=redis://localhost:6379
REDIS_REQUIRED=false
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false
API_BODY_LIMIT=2mb
PALM_MATCH_THRESHOLD=0.88
PALM_DUPLICATE_THRESHOLD=0.97
PALM_MIN_QUALITY=0.18
# Local LSH candidate retrieval bounds. Production should use a managed ANN index.
PALM_IDENTIFY_CANDIDATE_LIMIT=10
PALM_DUPLICATE_CANDIDATE_LIMIT=50
PALM_RATE_LIMIT_PER_MINUTE=300
PALM_MAX_ATTEMPTS=5
PALM_LOCKOUT_SECONDS=300
OTP_TTL_SECONDS=300
PIN_MAX_ATTEMPTS=5
PIN_LOCKOUT_SECONDS=900
PAYMENT_CLEANUP_INTERVAL_SECONDS=60
RISK_MEDIUM_THRESHOLD=30
RISK_HIGH_THRESHOLD=60
RISK_BLOCKED_THRESHOLD=80
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60
DEMO_ADMIN_EMAIL=admin@demo.local
DEMO_MERCHANT_EMAIL=merchant@demo.local
DEMO_CUSTOMER_EMAIL=customer@demo.local
DEMO_AUDITOR_EMAIL=auditor@demo.local
DEMO_SEED_PASSWORD=
DEMO_PAYMENT_PIN=2580
# Leave these same-origin values in production; Vite proxies them in development.
VITE_API_URL=/api/v1
VITE_SOCKET_URL=
