# Physical device: replace 192.168.x.x with the development computer's LAN IP.
EXPO_PUBLIC_API_URL=http://192.168.x.x:4000/api/v1

# Android emulator alternative:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:4000/api/v1

# iOS simulator alternative:
# EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1

# Production must use the deployed HTTPS API:
# EXPO_PUBLIC_API_URL=https://api.example.com/api/v1
