{
  "expo": {
    "name": "Nepal Hand Pay",
    "slug": "nepal-hand-pay-mobile",
    "scheme": "nepalhandpay",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Nepal Hand Pay to capture palm images for the prototype recognition flow.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Allow Nepal Hand Pay to protect your session."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0b3b2e",
          "resizeMode": "contain"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nepalhandpay.mobile",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.nepalhandpay.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0b3b2e"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
